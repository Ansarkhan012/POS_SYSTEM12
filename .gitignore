# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# ---------------------------------------------------------------------------
# Dokan Pro (Phase 1, SECURITY.md §9): never commit real configuration,
# secrets, keystores or signing properties.
# ---------------------------------------------------------------------------
# Real dart-define files; only placeholder *.example.json files are tracked.
config/*.json
!config/*.example.json
.env
.env.*
*.jks
*.keystore
key.properties
**/key.properties

# Generated localization code (ADR-028): produced by `flutter gen-l10n`.
lib/l10n/app_localizations*.dart

# Generated Drift code (ADR-029, P2-D1): produced by `dart run build_runner build`.
*.g.dart
# Generated Drift schema test helpers (regenerated from drift_schemas/).
test/core/database/generated/
